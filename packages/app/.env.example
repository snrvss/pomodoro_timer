# Copy to .env.local and adjust. Vite reads these from packages/app.

# Which quote source the app uses: `mock` (local JSON, no network) or `http` (the API below)
VITE_QUOTE_ADAPTER=mock

# Base URL of the DummyJSON-compatible quote API, used with VITE_QUOTE_ADAPTER=http
VITE_QUOTE_API_URL=https://dummyjson.com
